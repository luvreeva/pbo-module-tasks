using System.Collections.Generic;
namespace SistemPerpustakaan;

class Item
{
    public string Judul { get; set; }
    public int Tahun { get; set; }
    public Item(string judul, int tahun)
    {
        Judul = judul;
        Tahun = tahun;
    }

    public virtual void Deskripsi()
    {
        Console.WriteLine($"Item dengan judul {Judul} terbit pada tahun {Tahun}");
    }

    public virtual void InfoItem()
    {
        Console.WriteLine($"Informasi Item:");
        Console.WriteLine($"Judul: {Judul}");
        Console.WriteLine($"Tahun: {Tahun}");
    }
}

class Buku : Item
{
    public string Penulis { get; set; }
    public Buku(string judul, int tahun, string penulis)
        : base(judul, tahun)
    {
        Penulis = penulis;
    }
    
    public override void Deskripsi()
    {
        Console.WriteLine($"Buku ini berjudul '{Judul}', yang ditulis oleh {Penulis} pada tahun {Tahun}");
    }
    
    public void CekPenulis()
    {
        Console.WriteLine($"Buku ini ditulis oleh {Penulis}");
    }

}

class Majalah : Item
{
    public int Edisi { get; set; }
    public Majalah(string judul, int tahun, int edisi)
        : base(judul, tahun)
    {
        Edisi = edisi;
    }

    public override void Deskripsi()
    {
        Console.WriteLine($"Majalah '{Judul}' edisi ke-{Edisi} diliris pada tahun {Tahun}");
    }

    public void InfoEdisi()
    {
        Console.WriteLine($"Majalah ini edisi ke: {Edisi}");
    }

}

class Novel : Buku
{
    public Novel(string judul, int tahun, string penulis)
        : base(judul, tahun, penulis) { }

    public override void Deskripsi()
    {
        Console.WriteLine($"Novel '{Judul}' yang ditulis oleh {Penulis}, diterbitkan pada tahun {Tahun}");
    }

    public void BacaSinopsis()
    {
        Console.WriteLine($"Membaca sinopsis novel '{Judul}'.....");
    }
}

class Komik : Buku
{
    public Komik(string judul, int tahun, string penulis)
        : base(judul, tahun, penulis) { }

    public override void Deskripsi()
    {
        Console.WriteLine($"Komik '{Judul}' yang terbit pada tahun {Tahun}, merupakan karya {Penulis}");
    }

    public void TampilkanIlustrasi()
    {
        Console.WriteLine($"Menampilkan ilustrasi komik '{Judul}'.....");
    }
}

class MajalahAnak : Majalah
{
    public MajalahAnak(string judul, int tahun, int edisi)
        : base(judul, tahun, edisi) { }

    public override void Deskripsi()
    {
        Console.WriteLine($"Majalah anak '{Judul}' edisi ke-{Edisi} terbit pada tahun {Tahun}");
    }

    public void KategoriAnak()
    {
        Console.WriteLine($"Kategori Majalah Anak: {Judul}");
    }
}

class MajalahTeknologi : Majalah
{
    public MajalahTeknologi(string judul, int tahun, int edisi)
        : base(judul, tahun, edisi) { }

    public override void Deskripsi()
    {
        Console.WriteLine($"Majalah Teknologi '{Judul}' edisi ke-{Edisi} terbit pada tahun {Tahun}");
    }

    public void TopikTeknologi()
    {
        Console.WriteLine($"Topik teknologi dalam majalah '{Judul}' adalah Aerodinamika");
    }
}

class Perpustakaan
{
    public List<Item> daftarItem = new List<Item>();

    public void TambahItem(Item item)
    {
        daftarItem.Add(item);
        Console.WriteLine($"Item '{item.Judul}' berhasil ditambahkan.");

        
    }

    public void DaftarItem()
    {
        Console.WriteLine("\n====== DAFTAR KOLEKSI PERPUSTAKAAN ======");
        foreach (Item item in daftarItem)
        {
            item.Deskripsi();
        }
    }
}

class Program
{
    public static void Main()
    {
        Perpustakaan perpus = new Perpustakaan();

        Novel novel1 = new Novel("Red Lights, Green Fate", 2005, "Maxemillian");
        Komik komik1 = new Komik("Pit Stop Panic", 2025, "Stephanie");
        MajalahAnak majalahAnak = new MajalahAnak("HI5", 2023, 14);
        MajalahTeknologi majalahTekno = new MajalahTeknologi("AeroTech Racing", 2000, 10);
        Majalah majalah1 = new Majalah("Gilmore", 2001, 11);
        Buku buku1 = new Buku("Princess and Her Prince", 2000, "Orlunee");

        Console.WriteLine("=== MENAMBAHKAN ITEM ===");
        perpus.TambahItem(novel1);
        perpus.TambahItem(komik1);
        perpus.TambahItem(majalahAnak);
        perpus.TambahItem(majalahTekno);

        perpus.DaftarItem();

        Console.WriteLine("\n=== SOAL 1: Method Deskripsi() pada Novel dan Majalah ===");
        novel1.Deskripsi();
        majalah1.Deskripsi();

        Console.WriteLine("\n=== SOAL 2: Method BacaSinopsis() pada objek Novel ===");
        novel1.BacaSinopsis();

        Console.WriteLine("\n=== SOAL 3: Menampilkan informasi lengkap (judul, tahun, penulis) dari objek Novel ===");
        novel1.Deskripsi();

        Console.WriteLine("\n=== SOAL 4: Method TopikTeknologi() pada objek MajalahTeknologi ===");
        majalahTekno.TopikTeknologi();

        Console.WriteLine("\n=== SOAL 5: Variabel Item diisi dengan objek Komik ===");
        Item itemPolymorphic = komik1;  
        itemPolymorphic.Deskripsi();


        Console.WriteLine("\n=============== Polymorphism ===============");
        buku1.Deskripsi();
        majalah1.Deskripsi();
        novel1.Deskripsi();
        komik1.Deskripsi();
        majalahAnak.Deskripsi();
        majalahTekno.Deskripsi();

        Console.WriteLine("\n=============== Method Khusus ===============");
        buku1.CekPenulis();
        majalah1.InfoEdisi();
        novel1.BacaSinopsis();
        komik1.TampilkanIlustrasi();
        majalahAnak.KategoriAnak();
        majalahTekno.TopikTeknologi();

    }
}
